COMPOSE_IGNORE_ORPHANS=True
# Database settings
POSTGRES_PASSWORD=
POSTGRES_USER=mcod
POSTGRES_DB=mcod
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_HOST_TYPE=docker
POSTGRES_HOST_AUTH_METHOD=md5
# Redis settings
REDIS_URL=redis://localhost:6379
# Elasticsearch settings
ELASTICSEARCH_HOSTS=localhost:9200
# Rabbitmq settings
RABBITMQ_HOST=localhost:5672
# App settings
DJANGO_SETTINGS_MODULE=mcod.settings.jury
ENVIRONMENT=local
DEBUG=yes
SESSION_COOKIE_PREFIX=local
SESSION_COOKIE_DOMAIN=mcod.local
SESSION_COOKIE_SECURE=no
API_CSRF_COOKIE_DOMAINS=mcod.local,localhost
BASE_URL=https://mcod.local
API_URL=https://api.mcod.local
API_URL_INTERNAL=https://api.mcod.local
ADMIN_URL=https://admin.mcod.local
CMS_URL=https://cms.mcod.local
ALLOWED_HOSTS=*

# Enables API limiters - default value: True
FALCON_LIMITER_ENABLED=yes

# Email sending
EMAIL_HOST=mcod-smtp
# EMAIL_HOST=localhost
NO_REPLY_EMAIL=no-reply@mcod.local

GUNICORN_CMD_ARGS="--worker-class gevent --timeout=120"
# BOKEH settings
BOKEH_DEV=True
BOKEH_RESOURCES=cdn
BOKEH_ALLOW_WS_ORIGIN=mcod.local
BOKEH_LOG_LEVEL=debug
BOKEH_PY_LOG_LEVEL=debug
BOKEH_MINIFIED=False
BOKEH_VALIDATE_DOC=True
BOKEH_PRETTY=True
STATS_LOG_LEVEL=DEBUG
# RDF Database settings
FUSEKI_URL=http://localhost:3030
FUSEKI_DATASET_1=ds
SPARQL_PASSWORD=
SPARQL_USER=admin
# Main DGA
MAIN_DGA_DATASET_OWNER_ORGANIZATION_PK=2844

DATASET_ARCHIVE_FILES_TASK_DELAY=1

# forum
DISCOURSE_FORUM_ENABLED=false
DISCOURSE_USERNAME=user
DISCOURSE_PASSWORD=
DISCOURSE_HOST=https://forum.mcod.local
DISCOURSE_API_KEY=
DISCOURSE_SSO_SECRET=

# logingovpl settings
USERS_TEST_LOGINGOVPL=false
FRONTEND_BASE_URL=""
FIELD_ENCRYPTION_KEYS=

DB_ES_CONSISTENCY_EMAIL_RECIPIENTS=admin@mcod.local

# Celery beat settings

# Enables the generation of monthly reports - default value: False
# ENABLE_MONTHLY_REPORTS=True

# Enables the generation of a XML metadate report - default value: True
# ENABLE_CREATE_XML_METADATA_REPORT=False

# Allows you to change the execution time of periodic tasks
# UPDATE_TASKS_CELERY_BEAT_TIME='{"catalog_csv_file_creation": {"hour": 9, "minute": 44}, "catalog_xml_file_creation":{"hour": 11, "minute": 46}}'

# Enables exclude Developers' resources from brokenliks checking - default value: True
# BROKEN_LINKS_EXCLUDE_DEVELOPERS=False

# Set max size for reports request in admin
RESOURCE_MAX_REPORT_SIZE=100000


# nginx proxy pass configuration, adjust to use on-host python services or dockerised
# common:
MCOD_NGINX_FRONTEND=http://host.docker.internal:4200
MCOD_NGINX_DISCOURSE=http://172.18.18.140:3000
MCOD_NGINX_MAILHOG=http://172.18.18.22:8025
# for dockerised environment:
MCOD_NGINX_WS=http://172.18.18.104:8001
MCOD_NGINX_PN_APPS=http://172.18.18.101:8001
MCOD_NGINX_API=http://172.18.18.102:8000
MCOD_NGINX_ADMIN=http://172.18.18.101:8001
MCOD_NGINX_CMS=http://172.18.18.103:8002
# for bare metal:
# MCOD_NGINX_WS=http://host.docker.internal:8001
# MCOD_NGINX_PN_APPS=http://host.docker.internal:8001
# MCOD_NGINX_API=http://host.docker.internal:8000
# MCOD_NGINX_ADMIN=http://host.docker.internal:8001
# MCOD_NGINX_CMS=http://host.docker.internal:8002

# ==============================================================================
# CONTENT SECURITY POLICY (CSP)
# ==============================================================================

# CSP Enforcement Mode
# False -> Enforce policy (Block violations)
# True  -> Report only (Log violations only)
CSP_REPORT_ONLY=False
METABASE_URL=https://metabase.dane.gov.pl
MATOMO_URL=stats.dane.gov.pl

