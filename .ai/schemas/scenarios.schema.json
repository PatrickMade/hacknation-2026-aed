{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QA scenario catalog v1",
  "description": "A project's QA scenarios and feature groups. Stable scenario IDs are shared by the task, the spec, the tester instructions, the evidence and the QA verdict. No history fields: results live in QA verdict records. core/tools/scenarios.py validates a catalog against this schema and then checks references and flow files.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "scenarios", "featureGroups"],
  "properties": {
    "schemaVersion": {"const": 1},
    "scenarios": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/scenario"}},
    "featureGroups": {"type": "array", "items": {"$ref": "#/$defs/featureGroup"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*(-[A-Z0-9]+)+$"},
    "text": {"type": "string", "minLength": 1},
    "repoPath": {"type": "string", "minLength": 1, "description": "A path relative to the repository root: no leading / or ./, no .. part, no backslash or whitespace at the ends (checked by scenarios.py)"},
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "feature", "title", "platforms", "state", "steps", "cleanup", "maestroFlow"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "feature": {"$ref": "#/$defs/id"},
        "title": {"$ref": "#/$defs/text"},
        "platforms": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["ios", "android"]}},
        "state": {"enum": ["planned", "source-implemented", "simulator-passed", "device-passed"]},
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["action", "expect"],
            "properties": {"action": {"$ref": "#/$defs/text"}, "expect": {"$ref": "#/$defs/text"}}
          }
        },
        "cleanup": {"type": "array", "items": {"$ref": "#/$defs/text"}},
        "maestroFlow": {"type": ["string", "null"], "pattern": "\\.ya?ml$", "description": "Repository path of the scenario's Maestro flow, or null while it has none"},
        "scripts": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/repoPath"}}
      }
    },
    "featureGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sourcePrefixes", "requiredScenarioIds"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z0-9]+([._-][a-z0-9]+)*$"},
        "sourcePrefixes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/repoPath"}},
        "requiredScenarioIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      }
    }
  }
}
